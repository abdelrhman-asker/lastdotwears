{
  "name": "egypt-fashion-commerce",
  "version": "0.1.0",
  "private": true,
  "description": "Production-oriented clothing commerce platform for the Egyptian market.",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "^22.12.0 || >=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @commerce/web --filter @commerce/api dev",
    "build": "corepack pnpm -r --if-present build",
    "lint": "corepack pnpm -r --if-present lint",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "test": "corepack pnpm -r --if-present test",
    "test:e2e": "corepack pnpm -r --if-present test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.9.6"
  }
}
