# Docker Compose identity and public hostname. Use the apex hostname without https://.
DOMAIN=shop.example.com
LETSENCRYPT_EMAIL=support@last-dot.com

# PostgreSQL is reachable only inside the Compose backend network.
POSTGRES_DB=commerce
POSTGRES_USER=commerce
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# API runtime.
NODE_ENV=production
APP_VERSION=1.0.0
PORT=4000
API_PREFIX=api/v1
# Generate every secret independently. Do not reuse values.
COOKIE_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_SECRET=replace-with-at-least-64-random-characters-for-access-tokens
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=last-dot-wears-api
JWT_AUDIENCE=last-dot-wears-web
REFRESH_TOKEN_PEPPER=replace-with-at-least-64-random-characters-for-refresh-tokens
REFRESH_TOKEN_TTL_DAYS=30
ONE_TIME_TOKEN_PEPPER=replace-with-at-least-64-random-characters-for-one-time-tokens
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30

# Production SMTP. Credentials must be provided together when authentication is required.
MAIL_TRANSPORT=smtp
MAIL_FROM_EMAIL=support@last-dot.com
MAIL_FROM_NAME=Last Dot
ORDER_NOTIFICATION_EMAIL=orders@last-dot.com
# The envelope From address must be the authenticated Zoho mailbox (or a verified alias).
EMAIL_FROM="Last Dot <orders@last-dot.com>"
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
# Leave both empty only when the SMTP server explicitly permits unauthenticated relay.
SMTP_USER=orders@last-dot.com
SMTP_PASSWORD=

# Product and banner images are stored on the persistent API volume.
UPLOAD_ROOT=/app/uploads
PRODUCT_IMAGE_MAX_BYTES=8000000

# Commerce fallbacks used before the database seed. Values become admin-managed after seeding.
GUEST_SESSION_TTL_DAYS=90
ORDER_NUMBER_PREFIX=LDW
INSTAPAY_ID=abdelrhman_asker@instapay
INSTAPAY_QR_VALUE=
INSTAPAY_INSTRUCTIONS=Transfer the exact order total, include your order number, then wait for confirmation.

# Operational policy.
SWAGGER_ENABLED=false
LOG_LEVEL=info
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=100

# Required for the initial idempotent seed. Rotate seed passwords after the first deployment.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Replace-With-A-Strong-Admin-Password!42
SEED_CUSTOMER_EMAIL=customer@example.com
SEED_CUSTOMER_PASSWORD=Replace-With-A-Strong-Customer-Password!42
