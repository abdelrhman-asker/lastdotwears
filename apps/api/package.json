{
  "name": "@commerce/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "prebuild": "prisma generate",
    "build": "nest build",
