    "globals": "^16.0.0",
    "jest": "^30.4.2",
    "pino-pretty": "^13.0.0",
    "prisma": "^7.9.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.12",
    "tsx": "^4.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0"
