NODE_ENV=development
APP_VERSION=0.1.0
PORT=4000
API_PREFIX=api/v1

DATABASE_URL=postgresql://commerce:commerce@localhost:5432/commerce?schema=public

CORS_ORIGINS=http://localhost:3000,https://www.last-dot.com,https://last-dot.com
COOKIE_SECRET=replace-this-with-at-least-32-random-characters
JWT_ACCESS_SECRET=replace-this-with-at-least-64-random-characters-for-access-tokens
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=egypt-fashion-api
JWT_AUDIENCE=egypt-fashion-web
REFRESH_TOKEN_PEPPER=replace-this-with-at-least-64-random-characters-for-refresh-tokens
REFRESH_TOKEN_TTL_DAYS=30
ONE_TIME_TOKEN_PEPPER=replace-this-with-at-least-64-random-characters-for-one-time-tokens
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30

WEB_APP_URL=http://localhost:3000
MAIL_TRANSPORT=log
MAIL_FROM_EMAIL=support@last-dot.com
MAIL_FROM_NAME=Last Dot
ORDER_NOTIFICATION_EMAIL=orders@last-dot.com
EMAIL_FROM="Last Dot <orders@last-dot.com>"
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=

UPLOAD_ROOT=./uploads
PRODUCT_IMAGE_MAX_BYTES=8000000
GUEST_SESSION_TTL_DAYS=90
ORDER_NUMBER_PREFIX=LDW
INSTAPAY_ID=abdelrhman_asker@instapay
INSTAPAY_QR_VALUE=
INSTAPAY_INSTRUCTIONS=Transfer the exact order total, include your order number, then wait for confirmation.

SWAGGER_ENABLED=true
LOG_LEVEL=debug
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=100

# Required only when running the database seed.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Replace-With-A-Strong-Admin-Password!42
SEED_CUSTOMER_EMAIL=customer@example.com
SEED_CUSTOMER_PASSWORD=Replace-With-A-Strong-Customer-Password!42


# corepack pnpm --filter @commerce/web dev
# corepack pnpm --filter @commerce/api dev
