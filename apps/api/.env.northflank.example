# API runner runtime variables. Inject secrets through Northflank.
NODE_ENV=production
APP_VERSION=0.1.0
PORT=4000
API_PREFIX=api/v1
DATABASE_URL=postgresql://<user>:<password>@<neon-pooled-host>/<database>?sslmode=require
CORS_ORIGINS=https://www.last-dot.com,https://last-dot.com
WEB_APP_URL=https://www.last-dot.com
CATALOG_REVALIDATION_SECRET=
COOKIE_SECRET=<independent-random-secret-at-least-32-characters>
ADMIN_SETUP_ENABLED=false
ADMIN_SETUP_SECRET=
JWT_ACCESS_SECRET=<independent-random-secret-at-least-64-characters>
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=egypt-fashion-api
JWT_AUDIENCE=egypt-fashion-web
REFRESH_TOKEN_PEPPER=<independent-random-secret-at-least-64-characters>
REFRESH_TOKEN_TTL_DAYS=30
ONE_TIME_TOKEN_PEPPER=<independent-random-secret-at-least-64-characters>
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
MAIL_TRANSPORT=smtp
MAIL_FROM_EMAIL=support@last-dot.com
MAIL_FROM_NAME=Last Dot Wears
ORDER_NOTIFICATION_EMAIL=orders@last-dot.com
SMTP_HOST=<zoho-host-from-account-settings>
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=orders@last-dot.com
SMTP_PASSWORD=
SUPPORT_SMTP_USER=support@last-dot.com
SUPPORT_SMTP_PASSWORD=
SUPPORT_MAIL_FROM_EMAIL=support@last-dot.com
SUPPORT_NOTIFICATION_EMAIL=support@last-dot.com
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>
# Optional legacy file fallback, used only for restored files.
UPLOAD_ROOT=/app/uploads
PRODUCT_IMAGE_MAX_BYTES=8000000
GUEST_SESSION_TTL_DAYS=90
ORDER_NUMBER_PREFIX=LDW
# Optional commerce fallback overrides
# INSTAPAY_ID=<business-payment-id>
# INSTAPAY_QR_VALUE=<complete-https-payment-link-on-ipn.eg>
# INSTAPAY_INSTRUCTIONS=<customer-payment-instructions>
SWAGGER_ENABLED=false
LOG_LEVEL=info
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=100
